{
  "version": 1,
  "author": "Likith Shetty",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-dht22",
      "id": "dht",
      "top": -110,
      "left": 250,
      "attrs": { "temperature": "24", "humidity": "55" }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr",
      "top": 30,
      "left": 260,
      "attrs": {}
    },
    {
      "type": "wokwi-pir-motion-sensor",
      "id": "pir",
      "top": 170,
      "left": 250,
      "attrs": {}
    },
    {
      "type": "board-ssd1306",
      "id": "oled",
      "top": -200,
      "left": -30,
      "attrs": { "i2cAddress": "0x3c" }
    },
    { "type": "wokwi-relay-module", "id": "relay", "top": 240, "left": -250, "attrs": {} },
    {
      "type": "wokwi-led",
      "id": "ledLight",
      "top": -70,
      "left": -170,
      "attrs": { "color": "yellow", "label": "LIGHTS" }
    },
    { "type": "wokwi-resistor", "id": "rLight", "top": 20, "left": -190, "attrs": { "value": "220" } },
    {
      "type": "wokwi-led",
      "id": "ledFan",
      "top": 160,
      "left": -420,
      "attrs": { "color": "blue", "label": "FAN" }
    },
    { "type": "wokwi-resistor", "id": "rFan", "top": 250, "left": -420, "attrs": { "value": "220" } },
    { "type": "wokwi-buzzer", "id": "buzzer", "top": 60, "left": -340, "attrs": { "volume": "0.1" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "esp:3V3", "dht:VCC", "red", [ "h20", "v-40" ] ],
    [ "esp:GND.2", "dht:GND", "black", [ "h30", "v-20" ] ],
    [ "esp:D15", "dht:SDA", "green", [ "h40", "v-10" ] ],

    [ "esp:3V3", "ldr:VCC", "red", [ "h20", "v20" ] ],
    [ "esp:GND.2", "ldr:GND", "black", [ "h30", "v30" ] ],
    [ "esp:D34", "ldr:AO", "green", [ "h40", "v10" ] ],

    [ "esp:3V3", "pir:VCC", "red", [ "h20", "v120" ] ],
    [ "esp:GND.2", "pir:GND", "black", [ "h30", "v130" ] ],
    [ "esp:D13", "pir:OUT", "green", [ "h40", "v110" ] ],

    [ "esp:3V3", "oled:VCC", "red", [ "h-20", "v-60" ] ],
    [ "esp:GND.1", "oled:GND", "black", [ "h-30", "v-60" ] ],
    [ "esp:D21", "oled:SDA", "blue", [ "h-40", "v-60" ] ],
    [ "esp:D22", "oled:SCL", "cyan", [ "h-50", "v-60" ] ],

    [ "esp:D25", "ledLight:A", "yellow", [ "h-20", "v-20" ] ],
    [ "ledLight:C", "rLight:1", "black", [ "v10", "h-10" ] ],
    [ "rLight:2", "esp:GND.1", "black", [ "v20", "h40" ] ],

    [ "esp:D27", "buzzer:2", "purple", [ "h-60", "v0" ] ],
    [ "buzzer:1", "esp:GND.1", "black", [ "v-20", "h60" ] ],

    [ "esp:VIN", "relay:VCC", "red", [ "h-20", "v200" ] ],
    [ "esp:GND.1", "relay:GND", "black", [ "h-30", "v200" ] ],
    [ "esp:D26", "relay:IN", "green", [ "h-40", "v200" ] ],

    [ "esp:VIN", "relay:COM", "red", [ "h-60", "v240" ] ],
    [ "relay:NO", "ledFan:A", "orange", [ "v-40", "h-60" ] ],
    [ "ledFan:C", "rFan:1", "black", [ "v10", "h0" ] ],
    [ "rFan:2", "esp:GND.1", "black", [ "v20", "h200" ] ]
  ],
  "dependencies": {}
}
